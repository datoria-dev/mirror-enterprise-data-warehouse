Table DIM_ANCON_USERS {
  Note: '
Key Structure:
- PK: username (business username)
- NK: distinguished_name (LDAP identifier)
- AK: email_address (business email)

Critical Fields:
* password_last_changed: Source of truth for password age
* last_logon_date: Used for inactivity alerts
'
