# Snowflake Configuration for SSO (Okta) Authentication
# Copy this file as .env and update with your settings

# Your Snowflake account identifier (NOT the full URL)
# Example from screenshot: CRH-CRH_EDW
SNOWFLAKE_ACCOUNT=CRH-CRH_EDW

# Your email/login name (will be used in browser SSO)
# Example: FUAD.ONATE@OLDCASTLE.COM
SNOWFLAKE_USER=your.email@oldcastle.com

# Warehouse to use for queries
SNOWFLAKE_WAREHOUSE=DEV_WH

# Database name
SNOWFLAKE_DATABASE=ITSECKPI

# Schema name
SNOWFLAKE_SCHEMA=DEV_TRANSFORMATION

# Role to use (use ITSECKPI role for database access)
# Available roles: ITSECKPI, DEV_DEVELOPER, DEV_LANDING, QA_WH
SNOWFLAKE_ROLE=ITSECKPI

# Authentication method (sso for browser-based Okta login)
# Leave as 'sso' for Okta authentication
SNOWFLAKE_AUTH_METHOD=sso